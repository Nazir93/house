# =============================================================================
# СКОПИРУЙТЕ ЭТОТ ФАЙЛ В **frontend/.env** (папка с package.json и ecosystem.config.cjs)
#
# НЕ кладите .env только в корень репозитория (/var/www/house/.env) — Next.js и PM2
# ожидают файл в **…/house/frontend/.env**. Иначе админка и NextAuth не видят секреты.
#
# После правок: из frontend — npm run env:check
# На VPS после изменения .env: pm2 delete house-next; pm2 start ecosystem.config.cjs; pm2 save
# (ecosystem подхватывает .env автоматически; см. ecosystem.config.cjs)
#
# Подробности: DEPLOY-SERVER.md, SERVER-DEPLOY.md
# =============================================================================

# -----------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО на проде (иначе БД / админка / сессии не работают)
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/house?schema=public"
# После смены schema: в каталоге frontend — npx prisma migrate deploy

# Должны совпадать друг с другом и с адресом в браузере (https + домен после DNS).
# До переключения DNS — тест: http://46.173.26.108:8080
NEXT_PUBLIC_SITE_URL="https://chastdushi.ru"
NEXTAUTH_URL="https://chastdushi.ru"

# Случайные длинные строки (openssl rand -base64 32).
NEXTAUTH_SECRET="generate-a-random-string-do-not-use-this"

# Логин и пароль на https://ваш-сайт/admin/login
ADMIN_EMAIL="admin@example.com"
ADMIN_SECRET="generate-a-strong-admin-password"
# Рекомендуется на prod: node scripts/hash-admin-password.cjs "пароль" → ADMIN_PASSWORD_HASH
# ADMIN_PASSWORD_HASH="scrypt:..."

# Отдельно от NEXTAUTH_SECRET (редирект-map, internal API)
INTERNAL_API_SECRET="generate-a-random-internal-secret"

# Лимит Prisma-соединений на PM2-инстанс (по умолчанию 5)
# PRISMA_CONNECTION_LIMIT=5

# Макс. параллельных PDF-воркеров (Chromium)
# PROPOSAL_MAX_WORKERS=2

# CSP: 1 = enforced, иначе report-only
# CSP_ENFORCE=0

# -----------------------------------------------------------------------------
# Сайт (публичные NEXT_PUBLIC_* — попадают в клиентский бандл)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME="Часть души"
NEXT_PUBLIC_CITY="Санкт-Петербург"
NEXT_PUBLIC_SERVICE_REGIONS="Ленинградская область, Санкт-Петербург"

# Слоган в шапке (десктоп), подсказка у телефона
# NEXT_PUBLIC_HEADER_TAGLINE="Строительство домов под ключ"
# NEXT_PUBLIC_HEADER_PHONE_HINT="Ответим за 5 минут"

# Max: канал в подвале / личный чат в иконках «написать» (если пусто — дефолты в constants.ts)
# NEXT_PUBLIC_MAX_CHANNEL_URL="https://max.ru/id5300018030_biz"
# NEXT_PUBLIC_MAX_CHAT_URL="https://max.ru/u/f9LHodD0cOK3s_V3_9fIAc06d6ugU_K52gW4bcHHHEC8u7cxvjbJSKS8fts"
# NEXT_PUBLIC_TELEGRAM_URL="https://t.me/your_channel"

# Карта офиса (конструктор Яндекс.Карт + маршруты от метро в office-map.ts)
# NEXT_PUBLIC_YANDEX_OFFICE_MAP_CONSTRUCTOR_ID="d593a8746c275d580b8b91acec05d7045bbf3683b30195b4f7470a34648fb12f"
# NEXT_PUBLIC_OFFICE_GEO_LAT="59.9669"
# NEXT_PUBLIC_OFFICE_GEO_LON="30.3046"

# Внешний личный кабинет: если задать URL, /account редиректит наружу. Иначе кабинет на сайте.
# NEXT_PUBLIC_ACCOUNT_PORTAL_URL=""

# NEXT_PUBLIC_YANDEX_ORG_URL=""
# Отзывы на Яндекс.Картах (шапка: марка «Я» и рейтинг); если не задан — см. дефолт в constants.ts
# NEXT_PUBLIC_YANDEX_REVIEWS_URL="https://yandex.com/maps/org/everhouse/190163423712/reviews/"
# NEXT_PUBLIC_YANDEX_MAPS_RATING="5.0"
# Бесплатный ключ JS API Яндекс.Карт для публичной карты объектов: https://yandex.ru/dev/commercial/doc/ru/?from=mapsapi
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""
# NEXT_PUBLIC_BANNER_HERO_URL="/images/banner-hero.png"

# -----------------------------------------------------------------------------
# Формы: Yandex SmartCaptcha (если ключи пусты — проверка капчи на сервере может быть отключена)
# Production: оба ключа обязательны, иначе публичные формы останутся без captcha-челленджа.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY=""
YANDEX_SMARTCAPTCHA_SERVER_KEY=""

# -----------------------------------------------------------------------------
# Отклики на вакансии — SMTP Яндекс 360 / Почта для домена (РФ, без Resend)
# Получатель всегда info@chastdushi.ru (vacancy-response-mail.ts)
# Пароль приложения: id.yandex.ru → Безопасность → Пароли приложений
# -----------------------------------------------------------------------------

VACANCY_SMTP_HOST="smtp.yandex.ru"
VACANCY_SMTP_PORT="465"
# VACANCY_SMTP_SECURE="1"
VACANCY_SMTP_USER="noreply@chastdushi.ru"
VACANCY_SMTP_PASS=""
VACANCY_RESPONSE_FROM="Часть души <noreply@chastdushi.ru>"

# -----------------------------------------------------------------------------
# Прочие уведомления (legacy, сейчас не используется для откликов)
# -----------------------------------------------------------------------------

NOTIFICATION_EMAIL="info@example.com"

# -----------------------------------------------------------------------------
# Заявки: Telegram (альтернатива — настройки в /admin)
# -----------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# TELEGRAM_CHAT_IDS="-1001234567890,-1009876543210"
# TELEGRAM_MESSAGE_THREAD_ID="123"

# -----------------------------------------------------------------------------
# Заявки: Bitrix24 (входящий вебхук на создание лида)
# -----------------------------------------------------------------------------

# BITRIX_LEAD_WEBHOOK_URL="https://your-company.bitrix24.ru/rest/1/xxx/crm.lead.add"

# -----------------------------------------------------------------------------
# Аналитика (приоритет может быть у настроек в админке)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_YANDEX_METRIKA_ID="110112800"
NEXT_PUBLIC_GA_ID=""

# Верификация Яндекс.Вебмастера (meta-тег; альтернатива — HTML-файл в public/)
# YANDEX_VERIFICATION="3a6cddc74b4f4192"

# -----------------------------------------------------------------------------
# NextAuth за nginx / reverse proxy (CSRF, редиректы на /api/auth/signin)
# Задайте true, если сайт открывают как https://ваш-домен, а Node слушает :3000 за прокси.
# В nginx обязательно: proxy_set_header Host $host; и proxy_set_header X-Forwarded-Proto $scheme;
# (желательно: proxy_set_header X-Forwarded-Host $host;)
# -----------------------------------------------------------------------------
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# Runtime / прокси (опционально)
# -----------------------------------------------------------------------------

# NODE_ENV задаётся в PM2/ecosystem чаще, чем в файле.
# NODE_ENV=production

# Production health-check: обязателен на prod (deep=1 без секрета → 401).
HEALTH_CHECK_SECRET="generate-a-random-health-secret"

# Allowlist iframe-хостов для онлайн-камер в ЛК. По умолчанию разрешены rtsp.me/ivideon/yandex.
# CAMERA_IFRAME_ALLOWED_HOSTS="rtsp.me,ivideon.com"

# Редирект HTTP→HTTPS из middleware (нужны корректные X-Forwarded-* от nginx)
# MIDDLEWARE_HTTPS_REDIRECT="true"

# -----------------------------------------------------------------------------
# Playwright E2E (личный кабинет) — только dev/CI, не на проде без E2E_ENABLED=1
# Production: не включайте E2E_ENABLED=1, seed API должен оставаться недоступным.
# -----------------------------------------------------------------------------
# E2E_ENABLED=1
# E2E_SECRET=local-e2e-secret
