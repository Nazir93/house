# =============================================================================
# Шаблон переменных окружения (скопируйте в frontend/.env на сервере или в PM2)
# Файл .env не коммитится. Подробности: DEPLOY-SERVER.md
#
# После изменения на VPS: pm2 restart house-next --update-env
# Проверка: npm run env:check && npm run db:verify
# =============================================================================

# -----------------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО на проде (иначе БД / админка / сессии не работают)
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/house?schema=public"
# После смены schema: в каталоге frontend — npx prisma migrate deploy

# Должны совпадать друг с другом и с адресом в браузере (http + IP или https + домен).
# Без домена, nginx на порту 80:  http://ВАШ_IP
# Прямой доступ к Node :3000:    http://ВАШ_IP:3000
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"
NEXTAUTH_URL="http://127.0.0.1:3000"

# Случайные длинные строки (openssl rand -base64 32).
NEXTAUTH_SECRET="generate-a-random-string-do-not-use-this"

# Логин и пароль на https://ваш-сайт/admin/login
ADMIN_EMAIL="admin@dom.ru"
ADMIN_SECRET="generate-a-strong-admin-password"

# -----------------------------------------------------------------------------
# Сайт (публичные NEXT_PUBLIC_* — попадают в клиентский бандл)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME="Часть души"
NEXT_PUBLIC_CITY="Санкт-Петербург"
NEXT_PUBLIC_SERVICE_REGIONS="Ленинградская область, Санкт-Петербург"

# Слоган в шапке (десктоп), подсказка у телефона
# NEXT_PUBLIC_HEADER_TAGLINE="Строительство домов под ключ"
# NEXT_PUBLIC_HEADER_PHONE_HINT="Ответим за 5 минут"

# Ссылки в шапке/футере (если пусто — часть значений может браться из БД / constants)
NEXT_PUBLIC_MAX_CHAT_URL=""
# NEXT_PUBLIC_TELEGRAM_URL="https://t.me/your_channel"

# Карта офиса (дефолты в constants — ул. Ординарная, 18)
# NEXT_PUBLIC_OFFICE_GEO_LAT="59.9669"
# NEXT_PUBLIC_OFFICE_GEO_LON="30.3046"

# Внешний личный кабинет: если задать URL, /account редиректит наружу. Иначе кабинет на сайте.
# NEXT_PUBLIC_ACCOUNT_PORTAL_URL=""

# NEXT_PUBLIC_YANDEX_ORG_URL=""
# NEXT_PUBLIC_BANNER_HERO_URL="/images/banner-hero.png"

# -----------------------------------------------------------------------------
# Формы: Yandex SmartCaptcha (если ключи пусты — проверка капчи на сервере может быть отключена)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY=""
YANDEX_SMARTCAPTCHA_SERVER_KEY=""

# -----------------------------------------------------------------------------
# Заявки: e-mail (если используете Resend в коде уведомлений)
# -----------------------------------------------------------------------------

RESEND_API_KEY=""
NOTIFICATION_EMAIL="info@example.com"

# -----------------------------------------------------------------------------
# Заявки: Telegram (альтернатива — настройки в /admin)
# -----------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# TELEGRAM_CHAT_IDS="-1001234567890,-1009876543210"
# TELEGRAM_MESSAGE_THREAD_ID="123"

# -----------------------------------------------------------------------------
# Заявки: Bitrix24 (входящий вебхук на создание лида)
# -----------------------------------------------------------------------------

# BITRIX_LEAD_WEBHOOK_URL="https://your-company.bitrix24.ru/rest/1/xxx/crm.lead.add"

# -----------------------------------------------------------------------------
# Аналитика (приоритет может быть у настроек в админке)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_YANDEX_METRIKA_ID=""
NEXT_PUBLIC_GA_ID=""

# -----------------------------------------------------------------------------
# NextAuth за nginx / reverse proxy (CSRF, редиректы на /api/auth/signin)
# Задайте true, если сайт открывают как https://ваш-домен, а Node слушает :3000 за прокси.
# В nginx обязательно: proxy_set_header Host $host; и proxy_set_header X-Forwarded-Proto $scheme;
# (желательно: proxy_set_header X-Forwarded-Host $host;)
# -----------------------------------------------------------------------------
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# Runtime / прокси (опционально)
# -----------------------------------------------------------------------------

# NODE_ENV задаётся в PM2/ecosystem чаще, чем в файле.
# NODE_ENV=production

# Редирект HTTP→HTTPS из middleware (нужны корректные X-Forwarded-* от nginx)
# MIDDLEWARE_HTTPS_REDIRECT="true"
