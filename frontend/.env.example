# Шаблон переменных. На VPS см. DEPLOY-SERVER.md (там же про NEXTAUTH_URL и админку).
#
# === Database ===
# По умолчанию — PostgreSQL на этом ПК (порт 5432), пользователь и база house, затем: npm run db:push
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/house?schema=public"
# После изменения prisma/schema.prisma: примените миграции из prisma/migrations или `npm run db:push` (dev).
# Редко: SSH-туннель к Postgres на VPS (порт 5433) — см. scripts/db-tunnel.ps1 и frontend/package.json (db:tunnel).

# === Site ===
NEXT_PUBLIC_SITE_URL="https://dom.ru"
# Без домена выставьте тот же базовый URL, что и NEXTAUTH_URL (см. ниже блок Admin Auth).
NEXT_PUBLIC_SITE_NAME="Часть души"
# Слоган под логотипом в шапке (десктоп). Если не задан — см. HEADER_TAGLINE в constants.ts
# NEXT_PUBLIC_HEADER_TAGLINE="Строительство домов под ключ"
# Опционально: внешний URL личного кабинета. Если задан, /account уводит на этот адрес и встроенный кабинет на сайте не используется.
# Если переменная пуста — кабинет на сайте: /account/login (номер договора и пароль), данные в таблицах ClientConstruction* в PostgreSQL.
# NEXT_PUBLIC_ACCOUNT_PORTAL_URL="https://crm.example.com/login"
# Якорный город (офис в текстах и мета). Если не задано — Санкт-Петербург (см. constants.ts).
NEXT_PUBLIC_CITY="Санкт-Петербург"
# Зона работ через запятую (hero, SEO, schema.org areaServed). Если не задано — Ленинградская область и СПб.
NEXT_PUBLIC_SERVICE_REGIONS="Ленинградская область, Санкт-Петербург"

# Ссылка на чат Max (хедер/футер; при пустом значении в БД — дефолт из constants)
NEXT_PUBLIC_MAX_CHAT_URL="https://max.ru/u/f9LHodD0cOICVt6F_SbXekYin0iKseqgg53Vo-E4sCJ1sXjkB0Bs18LxWUg"

# === Yandex SmartCaptcha (защита форм от ботов) ===
# Ключи: https://cloud.yandex.com/ru/services/smartcaptcha
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_CLIENT_KEY=""
YANDEX_SMARTCAPTCHA_SERVER_KEY=""

# === Email (Resend) ===
RESEND_API_KEY=""
NOTIFICATION_EMAIL="info@dom.ru"

# === Telegram Bot (уведомления о заявках из POST /api/leads) ===
# Токен: @BotFather → /newbot → скопировать токен.
# Chat ID: личный чат — напишите боту /start, затем откройте в браузере:
#   https://api.telegram.org/bot<TOKEN>/getUpdates  и найдите "chat":{"id": ...}
# Группа: добавьте бота в группу, дайте право писать; id группы обычно отрицательный (в getUpdates).
# Альтернатива: задать те же значения в админке (/admin → Настройки → Telegram-уведомления), если в .env пусто.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Опционально: несколько получателей через запятую (если задано — используется вместо одного TELEGRAM_CHAT_ID)
# TELEGRAM_CHAT_IDS="-1001234567890,-1009876543210"
# Опционально: ID темы в супергруппе с включёнными темами (forum topic)
# TELEGRAM_MESSAGE_THREAD_ID="123"

# === Admin Auth ===
# После обновления Next.js: админы без поля role в JWT перелогиньтесь (вход через email как раньше).
ADMIN_EMAIL="admin@dom.ru"
ADMIN_SECRET="change-this-to-a-secure-random-string"
NEXTAUTH_SECRET="change-this-to-another-secure-random-string"
# Публичный URL так же, как в адресной строке браузера (схема + хост [+ порт]).
# Пример без домена: nginx на :80 → NEXTAUTH_URL=http://203.0.113.10 и NEXT_PUBLIC_SITE_URL то же.
# Прямой доступ к Next на :3000 → http://203.0.113.10:3000 в обоих переменных.
# На localhost для разработки можно http://localhost:3000.
NEXTAUTH_URL="https://dom.ru"

# === Runtime (VPS / PM2) ===
# NODE_ENV=production — чаще задаётся в ecosystem.config / PM2, не в файле.

# === Аналитика (fallback, если в админке не заданы ID в настройках сайта) ===
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
NEXT_PUBLIC_GA_ID=""
