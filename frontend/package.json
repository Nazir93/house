{
  "name": "dom",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "build": "node scripts/generate-pwa-icons.mjs && prisma generate --schema=prisma/schema.prisma && next build",
    "build:with-prisma": "prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "validate": "npm run check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "brochure:pdf": "node scripts/export-sales-brochure-pdf.mjs",
    "brochure:screenshots": "node scripts/capture-brochure-screenshots.mjs",
    "test:watch": "vitest",
    "check:with-e2e": "npm run check && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:push:server": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:verify": "node scripts/verify-db.cjs",
    "db:seed-calculator": "dotenv -e .env.local -- vitest run src/lib/seed-calculator-catalog.runner.test.ts",
    "db:migrate-calculator-categories": "node scripts/migrate-calculator-categories.mjs",
    "env:check": "node scripts/check-production-env.cjs",
    "db:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/db-tunnel.ps1",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload house-next"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "@hookform/resolvers": "^3.9.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "5.22.0",
    "@tiptap/extension-image": "^3.22.2",
    "@tiptap/extension-link": "^3.22.2",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/extension-underline": "^3.22.2",
    "@tiptap/pm": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "@yandex/smart-captcha": "^2.9.1",
    "clsx": "^2.1.0",
    "embla-carousel-react": "^8.3.0",
    "framer-motion": "^11.0.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.19",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.0.227",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-leaflet": "^5.0.0",
    "sanitize-html": "^2.17.4",
    "serwist": "^9.5.11",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.0",
    "uuid": "^14.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@serwist/turbopack": "^9.5.11",
    "@swc/helpers": "^0.5.23",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.10",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
