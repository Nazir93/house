generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  RESTAURANT
  OFFICE
  APARTMENT
  SHOP
  OTHER
}

enum ServiceType {
  ELECTRICAL
  ACOUSTICS
  STRUCTURED_CABLING
  SMART_HOME
  SECURITY
  ARCHITECTURAL_LIGHTING
  /// Загородное строительство (портфолио, услуги CMS, отзывы)
  HOUSE_DESIGN
  HOUSE_FOUNDATION
  HOUSE_STRUCTURE
  HOUSE_ROOFING
  HOUSE_ENGINEERING
  HOUSE_FINISHING
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ConstructionMediaType {
  RENDER
  PLAN
  BUILD_STAGE
  VIDEO
}

enum BuiltObjectMaterial {
  GAS_BLOCK
  BRICK
  CERAMIC_BLOCK
  FRAME
  OTHER
}

/// Статус площадки на карте портфолио (иконка и подпись).
enum BuiltObjectSiteStatus {
  COMPLETED
  UNDER_CONSTRUCTION
}

model Project {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  category       Category
  service        ServiceType
  area           Int?
  description    String         @db.Text
  /// Текст для meta description и карточки портфолио; если пусто — начало HTML-описания
  seoDescription String?        @db.Text
  coverImage     String
  /// Один ролик (совместимость; при заполнении videoUrls дублируется первый элемент)
  videoUrl       String?
  /// Несколько видео в карусели баннера (после фото)
  videoUrls      String[] @default([])
  location       String?
  year           String?
  industry       String?
  projectType    String?
  features       String?        @db.Text
  goals          String?        @db.Text
  /// Две колонки текста под первой «витриной» на странице кейса
  leftText1      String?        @db.Text
  rightText1     String?        @db.Text
  /// Две колонки текста под второй «витриной»
  leftText2      String?        @db.Text
  rightText2     String?        @db.Text
  /// Подпись на полосе-витрине (если пусто — alt 1-й / 2-й фото галереи)
  showcaseLabel1 String?
  showcaseLabel2 String?
  /// Фон витрины (если пусто — url 1-й / 2-й фото галереи)
  showcaseImage1 String?
  showcaseImage2 String?
  published      Boolean        @default(false)
  order          Int            @default(0)
  /// Блок «Портфолио» на главной: до 5 проектов с галочкой, порядок — homeOrder по возрастанию
  featuredOnHome Boolean        @default(false)
  homeOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  images         ProjectImage[]
  hotspots       Hotspot[]

  @@index([published, service])
  @@index([published, category])
  @@index([published, featuredOnHome, homeOrder])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  order     Int     @default(0)

  @@index([projectId])
}

model Hotspot {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl    String
  xPercent    Float
  yPercent    Float
  label       String
  description String  @db.Text

  @@index([projectId])
}

model HouseProject {
  id                  String                     @id @default(cuid())
  slug                String                     @unique
  title               String
  shortDescription    String                     @db.Text
  description         String                     @db.Text
  floors              Int
  area                Int
  price               Int
  rooms               Int
  bathrooms           Int
  materials           String[]                   @default([])
  isNew               Boolean                    @default(false)
  pricePromo          String?
  mortgageEnabled     Boolean                    @default(true)
  /// CALCULATOR = встроенный расчёт; LEAD = заявка и ссылка
  mortgageMode        String                     @default("LEAD")
  published           Boolean                    @default(false)
  order               Int                        @default(0)
  viewCount           Int                        @default(0)
  likeCount           Int                        @default(0)
  completionJson      Json?
  constructionJson    Json?
  /// Герой карточки проекта (уровни цен по материалу, гарантия, срок).
  heroPricingJson     Json?
  /// Калькулятор комплектации: этапы по PDF, опции, транспорт и виджет консультации.
  calculatorJson      Json?
  /// Категория дома для калькулятора (a–f). Если пусто — выводится из этажности и кровли.
  calculatorCategory  String?
  /// Ручная корректировка проекта, % (не показывается на сайте).
  projectAdjustmentPercent Float                  @default(0)
  /// Переопределения опций: { "disabledOptionIds": ["stairs", ...] }
  calculatorOptionOverrides Json?
  anchorsJson         Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  media               HouseProjectMedia[]
  builtObjects        BuiltObject[]
  clientBuildProjects ClientConstructionProject[]

  @@index([published, price])
  @@index([published, area])
  @@index([published, createdAt])
}

/// Категория дома a–f для калькулятора карточки проекта
model CalculatorCategory {
  id              String   @id
  labelRu         String
  floors          Float
  roofType        String
  facadeCoef      Float
  perimeterCoef   Float
  roofCoef        Float
  soffitCoef      Float
  gutterCoef      Float
  overlapCoef     Float
  insulationCoef  Float
  crossCoef       Float
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  shellPrices     CalculatorShellPrice[]

  @@map("calculator_category")
}

model CalculatorShellPrice {
  id           String             @id @default(cuid())
  categoryId   String
  category     CalculatorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  wallMaterial String
  pricePerM2   Int

  @@unique([categoryId, wallMaterial])
  @@map("calculator_shell_price")
}

model CalculatorFacadeType {
  id         String  @id
  slug       String  @unique
  name       String
  pricePerM2 Int
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  @@map("calculator_facade_type")
}

model CalculatorOption {
  id                String   @id
  slug              String   @unique
  name              String
  groupSlug         String
  pricingType       String
  pricePerUnit      Int
  description       String?  @db.Text
  imageUrl          String?
  allowedCategories String[] @default([])
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)

  @@index([groupSlug, isActive])
  @@map("calculator_option")
}

model CalculatorSettings {
  id                        String @id @default("default")
  smallAreaThresholdM2      Int    @default(100)
  smallAreaSurcharge        Float  @default(0.15)
  addonsSurchargeUnderThreshold Float @default(0.1)
  blindAreaWidthM           Float  @default(0.8)

  @@map("calculator_settings")
}

model HouseProjectMedia {
  id             String                @id @default(cuid())
  houseProjectId String
  houseProject   HouseProject          @relation(fields: [houseProjectId], references: [id], onDelete: Cascade)
  type           ConstructionMediaType
  url            String
  alt            String                @default("")
  label          String?
  floor          Int?
  order          Int                   @default(0)

  @@index([houseProjectId, type, order])
}

model BuiltObject {
  id                  String              @id @default(cuid())
  slug                String              @unique
  title               String
  material            BuiltObjectMaterial @default(GAS_BLOCK)
  area                Int?
  rooms               Int?
  bathrooms           Int?
  buildTerm           String?
  foundation          String?
  walls               String?
  roof                String?
  floors              Float?
  /// Регион для фильтров карты (slug: lo, mo, …).
  regionSlug          String?
  /// Район / населённый пункт (slug из справочника в админке).
  district            String?
  siteStatus          BuiltObjectSiteStatus @default(COMPLETED)
  location            String?
  latitude            Float?
  longitude           Float?
  description         String              @db.Text
  worksDescription    String?             @db.Text
  /// Этапы «История строительства» на публичной карточке: [{ id, title, description }]
  constructionHistoryJson Json?
  telegramUrl         String?
  vkUrl               String?
  houseProjectId      String?
  houseProject        HouseProject?       @relation(fields: [houseProjectId], references: [id], onDelete: SetNull)
  published           Boolean             @default(false)
  order               Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  media               BuiltObjectMedia[]

  @@index([published, material])
  @@index([published, order])
  @@index([published, regionSlug])
  @@index([houseProjectId])
}

model BuiltObjectMedia {
  id            String                @id @default(cuid())
  builtObjectId String
  builtObject   BuiltObject           @relation(fields: [builtObjectId], references: [id], onDelete: Cascade)
  type          ConstructionMediaType
  url           String
  alt           String                @default("")
  label         String?
  /// Ключ раздела кейса (foundation, walls, …) для BUILD_STAGE
  phaseKey      String?
  order         Int                   @default(0)

  @@index([builtObjectId, type, order])
  @@index([builtObjectId, phaseKey])
}

/// Счётчик запросов к POST /api/leads по IP в фиксированном окне времени (несколько инстансов приложения видят общий лимит).
model LeadIpRateBucket {
  ipKey       String
  bucketStart DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@id([ipKey, bucketStart])
  @@index([bucketStart])
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String
  email       String?
  service     String?
  pageUrl     String?
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  calcData    Json?
  status      LeadStatus @default(NEW)
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([service])
}

model Partner {
  id                 String  @id @default(cuid())
  name               String
  /// Опционально: в ленте банков можно показать только название
  logoUrl            String?
  website            String?
  visible            Boolean @default(true)
  order              Int     @default(0)
  /// Сетка «Нам доверяют» / «С кем работаем»
  showInTrustBlock   Boolean @default(true)
  /// Бегущая лента «Наши партнёры» перед блоком вопросов
  showInBankMarquee  Boolean @default(false)
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  position    String
  photoUrl    String?
  description String? @db.Text
  visible     Boolean @default(true)
  order       Int     @default(0)
}

model Review {
  id          String       @id @default(cuid())
  authorName  String
  authorPhoto String?
  objectName  String?
  service     ServiceType?
  rating      Int          @default(5)
  text        String       @db.Text
  videoUrl    String?
  visible     Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
}

model Faq {
  id       String       @id @default(cuid())
  question String
  answer   String       @db.Text
  service  ServiceType?
  visible  Boolean      @default(true)
  order    Int          @default(0)
}

/// Вакансии — раздел «Партнёры → Вакансии» на сайте
model Vacancy {
  id           String   @id @default(cuid())
  title        String
  location     String?
  schedule     String?
  salaryLabel  String?
  description  String   @db.Text
  requirements String?  @db.Text
  visible      Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Администратор")
  createdAt DateTime @default(now())
}

model Post {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String   @db.Text
  content    String   @db.Text
  category   String
  coverImage String?
  /// Одно видео (совместимость, дублирует первый элемент coverVideos)
  coverVideo  String?
  /// Несколько видео в карусели баннера (после обложки)
  coverVideos String[] @default([])
  /// Галерея фото (после обложки, перед видео)
  galleryUrls String[] @default([])
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, createdAt])
}

model Service {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  shortDescription   String      @db.Text
  serviceType        ServiceType
  icon               String      @default("zap")
  coverImage         String?
  videoUrl           String?
  /// Баннер под заголовком H1: широкий экран (отображается от md и выше).
  bannerImageDesktop String?
  /// Баннер для узких экранов (мобильные). Если пусто — на мобиле показывается desktop.
  bannerImageMobile  String?
  /// Блоки лендинга услуги (hero, тексты, FAQ и т.д.). null = шаблон из кода.
  landingJson        Json?
  published          Boolean     @default(true)
  order              Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([published, order])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([fromPath])
}

model ErrorLog {
  id        String   @id @default(cuid())
  path      String
  referer   String   @default("")
  userAgent String?
  count     Int      @default(1)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([path, referer])
  @@index([lastSeen])
}

model PageMeta {
  id            String  @id @default(cuid())
  path          String  @unique
  title         String?
  description   String? @db.Text
  keywords      String?
  ogTitle       String?
  ogDescription String? @db.Text
  ogImage       String?
  h1            String?
  /// Доп. HTML под мета-описанием (напр. страница «Услуги»): теги как в блоге, можно картинки и style
  bodyHtml      String? @db.Text
  noindex       Boolean @default(false)

  @@index([path])
}

model SiteSettings {
  key   String @id
  value String @db.Text
}

model ThankYouToken {
  id        String   @id @default(cuid())
  token     String   @unique
  leadName  String?
  source    String?
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

/// Статус этапа в личном кабинете клиента (стройка)
enum ClientStageStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum ClientPaymentStatus {
  NOT_ISSUED
  EXPECTED
  PAID
}

enum ClientSupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ClientTicketAuthorType {
  CLIENT
  STAFF
}

/// Тип уведомления в личном кабинете клиента (п. 7 ТЗ)
enum ClientNotificationType {
  PAYMENT_EXPECTED
  STAGE_IN_PROGRESS
  STAGE_DONE
  DOCUMENT_NEW
  PHOTO_NEW
  TICKET_REPLY
}

/// Статус документа в личном кабинете (ознакомление → подписание в офисе)
enum ClientDocumentSignatureStatus {
  AWAITING_REVIEW
  AWAITING_SIGNATURE
  SIGNED
}

/// Способ подписания: в офисе (вручную) или ЭП
enum ClientDocumentSignatureMethod {
  MANUAL
  ES
}

/// Объект договора: один номер договора + пароль = доступ в кабинет
model ClientConstructionProject {
  id                String               @id @default(cuid())
  contractNumber    String               @unique
  passwordHash      String
  clientName        String?
  clientEmail       String?
  title             String
  area              Int?
  wallMaterial      String?
  startDate         DateTime?
  plannedEndDate    DateTime?
  coverImageUrl     String?
  /// 0–100; может дублировать расчёт по этапам
  overallProgress   Int                  @default(0)
  currentStageLabel String?
  foremanName       String?
  cameraStreamUrl   String?
  houseProjectId    String?
  houseProject      HouseProject?        @relation(fields: [houseProjectId], references: [id], onDelete: SetNull)
  /// Черновик админки (поля, этапы, платежи) до публикации в ЛК
  draftData         Json?
  draftSavedAt      DateTime?
  /// Когда последний раз выгружали в личный кабинет клиента
  cabinetPublishedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  stages            ClientProjectStage[]
  payments          ClientPayment[]
  documents         ClientDocument[]
  photoReports      ClientPhotoReport[]
  tickets           ClientSupportTicket[]
  notifications     ClientNotification[]

  @@index([houseProjectId])
}

/// Уведомления клиента в кабинете (в перспективе — SMS / мессенджер)
model ClientNotification {
  id        String                 @id @default(cuid())
  projectId String
  project   ClientConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      ClientNotificationType
  title     String
  body      String                 @db.Text
  payload   Json?
  readAt    DateTime?
  createdAt DateTime               @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, readAt])
}

model ClientProjectStage {
  id        String            @id @default(cuid())
  projectId String
  project   ClientConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ClientProjectStage?  @relation("ClientStageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ClientProjectStage[] @relation("ClientStageTree")
  order     Int               @default(0)
  title     String
  iconKey   String            @default("circle")
  status    ClientStageStatus @default(NOT_STARTED)

  @@index([projectId, order])
  @@index([projectId, parentId])
}

/// Суммы в копейках (целое число)
model ClientPayment {
  id          String              @id @default(cuid())
  projectId   String
  project     ClientConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  amountKopeks Int
  dueDate     DateTime?
  status      ClientPaymentStatus @default(EXPECTED)
  paidAt      DateTime?
  order       Int                 @default(0)

  @@index([projectId, order])
  @@index([projectId, dueDate])
}

model ClientDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    ClientConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename   String
  url        String
  order            Int                           @default(0)
  isDraft          Boolean                       @default(false)
  signatureStatus    ClientDocumentSignatureStatus @default(AWAITING_REVIEW)
  signatureMethod    ClientDocumentSignatureMethod?
  signedByName       String?
  signatureSmsPhone  String?
  signedResultUrl    String?
  downloadedAt       DateTime?
  signedAt           DateTime?
  uploadedAt         DateTime                      @default(now())

  @@index([projectId, order])
  @@index([projectId, isDraft, order])
  @@index([projectId, uploadedAt])
}

model ClientPhotoReport {
  id        String   @id @default(cuid())
  projectId String
  project   ClientConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?  @default("")
  shotAt    DateTime?
  order     Int      @default(0)
  isDraft   Boolean  @default(false)

  @@index([projectId, order])
  @@index([projectId, isDraft, order])
}

model ClientSupportTicket {
  id              String                    @id @default(cuid())
  projectId       String
  project         ClientConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject         String
  status          ClientSupportTicketStatus @default(OPEN)
  /// Когда сотрудник последний раз открывал переписку (для бейджа «ждёт ответа»)
  staffLastReadAt DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  messages        ClientTicketMessage[]

  @@index([projectId, updatedAt])
}

model ClientTicketMessage {
  id         String                 @id @default(cuid())
  ticketId   String
  ticket     ClientSupportTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType ClientTicketAuthorType
  body       String                 @db.Text
  createdAt  DateTime               @default(now())

  @@index([ticketId, createdAt])
}
